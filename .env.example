# Copy to .env in the repository root and chmod 600 .env. Never commit the actual file.
# This file is trusted shell syntax, read by scripts/run-signer.sh.
# Generate PC_TOKEN locally: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
PC_TOKEN=''
PC_PASS_TYPE_ID='pass.com.yourcompany.pocketcard'
PC_TEAM_ID='YOURTEAMID'
PC_ORGANIZATION='PocketCard'
PC_CONTACT='support@your-domain.example'
# Store these OUTSIDE the repository. Absolute paths. PEM or DER certificates; PEM private key.
PC_CERTIFICATE='/absolute/path/outside/repository/pass.cer'
PC_PRIVATE_KEY='/absolute/path/outside/repository/pass-key.pem'
PC_WWDR_CERTIFICATE='/absolute/path/outside/repository/AppleWWDR.cer'
PC_APPLE_ROOT_CERTIFICATE='/absolute/path/outside/repository/AppleRootCA.cer'
PC_KEY_PASSWORD=''
# Loopback is for local tests or a reverse proxy running on this machine.
PC_BIND='127.0.0.1'
PC_PORT='8787'
# For direct HTTPS, provide a SERVER TLS certificate and its key (not the Apple pass certificate).
PC_TLS_CERTIFICATE=''
PC_TLS_PRIVATE_KEY=''
